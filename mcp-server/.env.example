# ── OrcaVault MCP server config ───────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env — only this example.

# Relay base URL. Default is the public Railway relay; override for local/staging.
ORCAVAULT_RELAY_URL=https://orcavault-production.up.railway.app

# House wallet private key (0x...). REQUIRED for uploads.
# This wallet is registered ONCE by paying the 2 LCAI relay fee. After that the
# relay pays all gas — it needs no ongoing balance. The server signs uploads with
# this key on behalf of any calling agent. Keep it in a secret manager, never git.
ORCAVAULT_AGENT_WALLET_KEY=

# Upload guards (protect the operator's gas from a runaway/abusive agent).
ORCAVAULT_MAX_UPLOAD_MB=5
ORCAVAULT_RATE_PER_MIN=3
ORCAVAULT_RATE_PER_DAY=50

# Networking / retrieval.
ORCAVAULT_HTTP_TIMEOUT=60
ORCAVAULT_STREAM_VERSION=v3
